rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net: Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'bryan2wyatt@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // System Access Control & Whitelist
    match /system/access_control {
      function isValidAccessControl(data) {
        return data.keys().hasAll(['enforceWhitelist', 'allowedEmails', 'adminEmails'])
          && data.enforceWhitelist is bool
          && data.allowedEmails is list
          && data.adminEmails is list;
      }

      allow get: if isSignedIn();
      allow create, update: if isAdmin() && isValidAccessControl(incoming());
      allow delete: if false;
    }

    // 1. User collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['uid', 'email']) 
          && data.uid == request.auth.uid 
          && data.email is string && data.email.size() <= 256
          && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 512))
          && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 4096));
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoURL', 'createdAt', 'lastLoginAt', 'uid']);
    }

      // Sub-collections
      
      // Library
      match /library/{entryId} {
        function isValidSavedEntry(data) {
          return data.keys().hasAll(['userId', 'title', 'outputText'])
            && data.userId == request.auth.uid
            && data.title is string && data.title.size() <= 256
            && data.inputText is string && data.inputText.size() <= 50000
            && data.outputText is string && data.outputText.size() <= 50000
            && (data.get('timestamp', 0) is number)
            && (data.get('mode', '') is string)
            && (data.get('tone', '') is string);
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(entryId) && isValidSavedEntry(incoming());
        allow update: if isOwner(userId) && isValidSavedEntry(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'inputText', 'outputText', 'mode', 'tone', 'timestamp']);
        allow delete: if isOwner(userId);
      }

      // Personas
      match /personas/{personaId} {
        function isValidPersona(data) {
          return data.keys().hasAll(['userId', 'name', 'content'])
            && data.userId == request.auth.uid
            && data.name is string && data.name.size() <= 128
            && data.content is string && data.content.size() <= 5000;
        }

        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(personaId) && isValidPersona(incoming());
        allow update: if isOwner(userId) && isValidPersona(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'content']);
        allow delete: if isOwner(userId);
      }

      // Workspace (Singleton per user)
      match /workspace/current {
        function isValidWorkspace(data) {
          return data.keys().hasAll(['userId'])
            && data.userId == request.auth.uid
            && (data.get('inputText', '') is string && data.get('inputText', '').size() <= 50000)
            && (data.get('result', '') is string || data.get('result', null) == null)
            && (data.get('mode', '') is string)
            && (data.get('tone', '') is string)
            && (data.get('batchItems', []) is list)
            && (data.get('updatedAt', 0) is number);
        }

        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId('current') && isValidWorkspace(incoming());
        allow update: if isOwner(userId) && isValidWorkspace(incoming());
        allow delete: if isOwner(userId); // Usually not needed but safe
      }
    }
  }
}
